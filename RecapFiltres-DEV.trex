<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.smcp.bi.recap-filtres-parametres.dev" extension-version="2.9.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>[DEV] Visual recap of the filters and parameters exposed on the dashboard, with export.</description>
    <author name="SMCP - Pôle Data-BI" email="Mouad.QARCHLI@smcp.com" organization="SMCP GROUP" website="https://www.smcp.com"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <!-- DEV: branch develop, published under /dev/ by the Pages workflow. Adjust the owner if the repo moves to the SMCP organisation. -->
      <url>https://mouadqarchli.github.io/tableau-ext-recap-filters/dev/index.html</url>
    </source-location>
    <icon></icon>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Filters &amp; parameters recap (DEV)</text>
      <text locale="fr_FR">Récap filtres &amp; paramètres (DEV)</text>
    </resource>
  </resources>
</manifest>
